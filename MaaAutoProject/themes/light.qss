/* ============ 全局 ============ */
* { font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif; font-size: 13px; }

QMainWindow, QDialog { background-color: #f5f7fa; }

QWidget#BackgroundRoot { background-color: transparent; }

/* ============ 侧边栏 ============ */
QWidget#Sidebar {
    background-color: rgba(240, 245, 250, 0.82);
    border-right: 1px solid rgba(0, 0, 0, 0.06);
    border-top-left-radius: 0px;
}
QLabel#AppTitle {
    font-size: 15px;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: 0.2px;
}
QPushButton#NavButton {
    text-align: left;
    padding: 10px 14px;
    border: none;
    border-radius: 8px;
    color: #334155;
    font-weight: 500;
    background: transparent;
    font-size: 13px;
}
QPushButton#NavButton:hover {
    background-color: rgba({accent_rgb}, 0.12);
    color: {accent_deep};
}
QPushButton#NavButton:checked {
    background-color: rgba({accent_rgb}, 0.20);
    color: {accent_deep};
    font-weight: 600;
}

/* ============ 页面标题 ============ */
QLabel#PageTitle { font-size: 22px; font-weight: 700; color: #111827; }
QLabel#SectionTitle { font-size: 15px; font-weight: 600; color: #1f2937; }

/* ============ 卡片 ============ */
QFrame#Card {
    background-color: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 12px;
}
QFrame#SettingGroup {
    background-color: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 12px;
}
QLabel#StatTitle { color: #6b7280; font-size: 12px; }
QLabel#StatValue { color: #111827; font-size: 20px; font-weight: 700; }
QLabel#GroupTitle { font-size: 15px; font-weight: 700; color: #1f2937; }
QLabel#SettingTitle { font-size: 13px; font-weight: 600; color: #1f2937; }
QLabel#SettingDesc { font-size: 12px; color: #6b7280; }

QFrame#Separator { background-color: rgba(0, 0, 0, 0.06); border: none; }

/* ============ 按钮 ============ */
QPushButton#PrimaryButton {
    background-color: {accent}; color: white;
    border: none; border-radius: 8px;
    padding: 8px 18px; font-weight: 600;
}
QPushButton#PrimaryButton:hover { background-color: {accent_hover}; }
QPushButton#PrimaryButton:pressed { background-color: {accent_pressed}; }
QPushButton#PrimaryButton:disabled { background-color: {accent_soft}; }

QPushButton#GhostButton {
    background-color: transparent; color: #4b5563;
    border: 1px solid #d1d5db; border-radius: 8px;
    padding: 6px 14px;
}
QPushButton#GhostButton:hover { background-color: rgba(0, 0, 0, 0.04); }

QPushButton#DangerButton {
    background-color: #ef4444; color: white; border: none;
    border-radius: 8px; padding: 8px 18px; font-weight: 600;
}
QPushButton#DangerButton:hover { background-color: #dc2626; }

/* ============ 输入控件 ============ */
QLineEdit, QSpinBox, QComboBox, QTimeEdit {
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid #d1d5db; border-radius: 6px;
    padding: 5px 8px; color: #111827;
    min-height: 22px;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QTimeEdit:focus {
    border-color: {accent};
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background-color: white; border: 1px solid #d1d5db;
    selection-background-color: rgba({accent_rgb}, 0.18);
    color: #111827;
}

QCheckBox { color: #1f2937; spacing: 8px; }
QCheckBox::indicator { width: 18px; height: 18px; border-radius: 4px; border: 1px solid #d1d5db; background: white; }
QCheckBox::indicator:checked { background-color: {accent}; border-color: {accent}; }

QRadioButton { color: #1f2937; spacing: 8px; }
QRadioButton::indicator { width: 16px; height: 16px; border-radius: 8px; border: 1px solid #d1d5db; background: white; }
QRadioButton::indicator:checked { background-color: {accent}; border: 4px solid #ffffff; outline: 1px solid {accent}; }

QSlider::groove:horizontal { height: 4px; background: #e5e7eb; border-radius: 2px; }
QSlider::handle:horizontal {
    background: {accent}; width: 14px; height: 14px;
    margin: -5px 0; border-radius: 7px;
}
QSlider::sub-page:horizontal { background: {accent}; border-radius: 2px; }

/* ============ 日志 ============ */
QTextEdit#LogView {
    background-color: rgba(17, 24, 39, 0.65);
    color: #d1d5db;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
    padding: 10px;
    font-family: "Cascadia Code", Consolas, monospace;
    font-size: 12px;
}

/* ============ 滚动条 ============ */
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical {
    background: transparent; width: 10px; margin: 4px 0;
}
QScrollBar::handle:vertical {
    background: rgba(0, 0, 0, 0.18); border-radius: 5px; min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: rgba(0, 0, 0, 0.30); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ============ 标签页 ============ */
QTabWidget::pane { border: none; }
QTabBar::tab {
    padding: 6px 14px; margin-right: 4px;
    border-radius: 6px; background: transparent; color: #6b7280;
}
QTabBar::tab:selected { background: rgba({accent_rgb}, 0.16); color: {accent_deep}; font-weight: 600; }

/* ============ 分组导航按钮 ============ */
QPushButton#JumpChip {
    background: rgba({accent_rgb}, 0.10);
    color: {accent_deep};
    border: none; border-radius: 14px;
    padding: 5px 14px; font-size: 12px;
}
QPushButton#JumpChip:hover { background: rgba({accent_rgb}, 0.22); }
QPushButton#JumpChip:checked {
    background: rgba({accent_rgb}, 0.22);
    color: {accent_deep};
    font-weight: 600;
}

/* ============ Switch ============ */
QAbstractButton#Switch {
    qproperty-accent: {accent};
    qproperty-trackOff: #e5e7eb;
    qproperty-knobColor: #ffffff;
}

/* ============ SegmentedControl ============ */
QWidget#SegmentedControl {
    background: rgba(0, 0, 0, 0.06);
    border-radius: 10px;
}
QPushButton#SegmentItem {
    border: none;
    padding: 6px 16px;
    border-radius: 8px;
    background: transparent;
    color: #4b5563;
    font-size: 12px;
    min-width: 90px;
}
QPushButton#SegmentItem:hover {
    background: rgba(0, 0, 0, 0.05);
}
QPushButton#SegmentItem:checked {
    background: #ffffff;
    color: {accent_deep};
    font-weight: 600;
}

/* ============ 设置滚动区透明底 ============ */
QWidget#SettingsContainer {
    background: transparent;
    border-radius: 14px;
}

/* 新手教程的滚动容器（不透明的话深色主题下会露白底） */
QWidget#TutorialContainer {
    background: transparent;
}

/* ============ 进程选择表 ============ */
QTableWidget {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
    gridline-color: transparent;
    selection-background-color: rgba({accent_rgb}, 0.14);
    selection-color: #111827;
}
QHeaderView::section {
    background: transparent;
    border: none;
    padding: 8px;
    color: #6b7280;
    font-weight: 600;
}
QTableWidget::item {
    padding: 4px 8px;
}

/* ============ 滚轮时间选择 ============ */
QListWidget#WheelColumn {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 14px;
    color: #2c3444;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    outline: none;
    padding: 0px;
}
QListWidget#WheelColumn:hover {
    background: rgba(0, 0, 0, 0.04);
}
QListWidget#WheelColumn:focus {
    background: rgba({accent_rgb}, 0.08);
    border: 1px solid rgba({accent_rgb}, 0.50);
}
QLabel#WheelColon {
    color: #334155;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 16px;
    font-weight: 700;
}

/* ============ 版本标签（关于页） ============ */
/* 旧实现把颜色写在内联样式里（#1d4ed8 深蓝），深色主题下几乎看不见 */
QLabel#VersionTag {
    background: rgba({accent_rgb}, 0.16);
    color: {accent_deep};
    border: 1px solid rgba({accent_rgb}, 0.28);
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 600;
}
QLabel#LicenseTag {
    background: rgba(16, 185, 129, 0.16);
    color: #047857;
    border: 1px solid rgba(16, 185, 129, 0.28);
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 600;
}

/* ============ 对话框（升级提示 / 公告 / 新手教程） ============ */
QLabel#DialogTitle { font-size: 20px; font-weight: 700; color: #111827; }
QLabel#DialogSubtitle { font-size: 12px; color: #6b7280; }
QLabel#DialogText { font-size: 13px; color: #374151; }
QLabel#DialogIconWarn { font-size: 24px; color: #d97706; }
QLabel#UpdateChannelTag {
    background: rgba({accent_rgb}, 0.14);
    color: {accent_deep};
    border-radius: 8px;
    padding: 1px 8px;
    font-size: 11px;
}
QTextBrowser#ReleaseNotes, QTextBrowser#AnnouncementBody {
    background: rgba(255, 255, 255, 0.80);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
    padding: 10px;
    color: #1f2937;
    font-size: 13px;
}
QListWidget#AnnouncementList {
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
    padding: 6px;
    outline: none;
}
QListWidget#AnnouncementList::item {
    border-radius: 6px;
    padding: 8px 10px;
    color: #334155;
    font-size: 13px;
}
QListWidget#AnnouncementList::item:hover { background: rgba(0, 0, 0, 0.04); }
QListWidget#AnnouncementList::item:selected {
    background: rgba({accent_rgb}, 0.16);
    color: {accent_deep};
    font-weight: 600;
}

/* 新手教程里的「必须做」提示块 */
QLabel#TutorialWarning {
    background: rgba(239, 68, 68, 0.10);
    border: 1px solid rgba(239, 68, 68, 0.45);
    border-left: 4px solid rgba(239, 68, 68, 0.85);
    border-radius: 8px;
    padding: 10px 12px;
    color: #b91c1c;
    font-size: 13px;
    font-weight: 600;
}

/* 有未读公告的按钮 */
QPushButton#GhostButtonHot {
    background: rgba({accent_rgb}, 0.12);
    color: {accent_deep};
    border: 1px solid rgba({accent_rgb}, 0.40);
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 600;
}
QPushButton#GhostButtonHot:hover { background: rgba({accent_rgb}, 0.20); }

/* ---- 定时编辑器（1.3.0）：星期按钮 + 时段列表 ---- */
QToolButton#WeekdayButton {
    border: 1px solid #d7dee9;
    border-radius: 6px;
    padding: 3px 0;
    background: transparent;
    color: #4a5568;
}
QToolButton#WeekdayButton:hover { background: rgba(0, 0, 0, 0.04); }
QToolButton#WeekdayButton:checked {
    background: rgba(59, 130, 246, 0.14);
    border-color: rgba(59, 130, 246, 0.5);
    color: #2b6cb0;
}
QListWidget#ScheduleTimeList {
    border: 1px solid #d7dee9;
    border-radius: 8px;
    background: transparent;
    padding: 2px;
}
