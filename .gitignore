# ============================================================
# MaaAuto .gitignore
# ============================================================

# ---------------- Python ----------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------------- Virtual environments ----------------
.venv/
venv/
ENV/
env/
.python-version
Pipfile.lock

# ---------------- Tests / coverage ----------------
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.hypothesis/
htmlcov/
*.cover
nosetests.xml
coverage.xml
*.mo
*.pot

# ---------------- Packaging (PyInstaller) ----------------
*.spec
build/
dist/
# Build artifacts
MaaAuto.exe
MaaAuto_*.zip

# ---------------- Generated at runtime ----------------
# User config and logs (must not be committed)
config/
logs/
# But keep directory placeholders (if needed)
!config/.gitkeep
!logs/.gitkeep

# ---------------- Image assets (optional) ----------------
# Uncomment the lines below if your screenshots should not be open-sourced
# resources/maa_start.png
# resources/maaend_start.png
# Icons are usually better committed
!resources/icon.ico

# ---------------- IDE / editors ----------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ---------------- Operating systems ----------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Linux
*~
.directory
.Trash-*

# ---------------- Misc ----------------
# Temporary files
*.bak
*.tmp
*.log
!logs/.gitkeep

# ---------------- Environment variables / secrets ----------------
.env
.env.*
*.key
secrets.json

# ---------------- Debugging ----------------
debug/
*.pdb
__pycache__/
*.py[cod]
build/
dist/
*.spec
_version_info.txt